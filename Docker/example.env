QDRANT_MCP_BRANCH=your-qdrant-mcp-branch
CONTAINER_UID=1000
CONTAINER_GID=1000
SOURCES_PATH=./sources

# MCP transport
TRANSPORT_MODE=http
HTTP_PORT=3000

# Qdrant
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_URL=http://qdrant:6333

# Embeddings
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=your-embedding-model
EMBEDDING_BASE_URL=http://your-embedding-host:11434
EMBEDDING_DIMENSIONS=your-embedding-dimensions

# Logging
LOG_LEVEL=info

# Code indexing
CODE_ENABLE_AST=true
CODE_CHUNK_SIZE=2500
CODE_CHUNK_OVERLAP=300
CODE_BATCH_SIZE=100
CODE_DEFAULT_LIMIT=5

# Git history
GIT_MAX_COMMITS=5000
GIT_INCLUDE_FILES=true
GIT_INCLUDE_DIFF=true
GIT_ENABLE_HYBRID=true
